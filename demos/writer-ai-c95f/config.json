{
  "title": "Diátaxis文档结构分析工具",
  "subtitle": "通过分析现有文档，快速识别缺失内容，提升文档结构化水平",
  "accent": "#2f6bff",
  "fields": [
    {
      "key": "documentContent",
      "label": "文档内容",
      "type": "textarea",
      "placeholder": "请输入您的产品说明或README内容",
      "required": true
    },
    {
      "key": "documentType",
      "label": "文档类型",
      "type": "radio",
      "options": [
        "产品介绍",
        "README",
        "使用手册",
        "技术博客"
      ],
      "required": true
    }
  ],
  "refine": false,
  "result": {
    "render": [
      {
        "field": "tutorials",
        "as": "section",
        "label": "教程（Tutorials）",
        "itemRender": [
          {
            "field": "tutorialSuggestions",
            "as": "text"
          }
        ]
      },
      {
        "field": "howToGuides",
        "as": "section",
        "label": "操作指南（How-to Guides）",
        "itemRender": [
          {
            "field": "howToSuggestions",
            "as": "text"
          }
        ]
      },
      {
        "field": "technicalReference",
        "as": "section",
        "label": "技术参考（Technical Reference）",
        "itemRender": [
          {
            "field": "referenceSuggestions",
            "as": "text"
          }
        ]
      },
      {
        "field": "explanation",
        "as": "section",
        "label": "原理阐述（Explanation）",
        "itemRender": [
          {
            "field": "explanationSuggestions",
            "as": "text"
          }
        ]
      },
      {
        "field": "summary",
        "as": "heading",
        "label": "总结"
      },
      {
        "field": "recommendations",
        "as": "section",
        "label": "补写建议"
      }
    ]
  }
}