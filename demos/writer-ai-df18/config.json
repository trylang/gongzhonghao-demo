{
  "title": "文档诊断工具",
  "subtitle": "利用AI分析文档结构，为传统行业和中小企业提供文档优化建议",
  "accent": "#2f6bff",
  "fields": [
    {
      "key": "documentType",
      "label": "文档类型",
      "type": "select",
      "options": [
        "教程",
        "操作指南",
        "参考资料",
        "概念解释"
      ],
      "placeholder": "选择文档类型",
      "required": true
    },
    {
      "key": "documentContent",
      "label": "文档内容",
      "type": "textarea",
      "placeholder": "粘贴您的文档内容",
      "required": true
    },
    {
      "key": "industry",
      "label": "所属行业",
      "type": "select",
      "options": [
        "制造业",
        "服务业",
        "零售业",
        "IT行业",
        "其他"
      ],
      "placeholder": "选择您的行业",
      "required": false
    },
    {
      "key": "targetAudience",
      "label": "目标受众",
      "type": "radio",
      "options": [
        "内部员工",
        "外部客户",
        "合作伙伴"
      ],
      "required": true
    }
  ],
  "refine": false,
  "result": {
    "render": [
      {
        "field": "coreIssues",
        "as": "heading",
        "label": "核心问题"
      },
      {
        "field": "suggestions",
        "as": "section",
        "label": "优化建议"
      },
      {
        "field": "missingSections",
        "as": "cards",
        "label": "缺失部分",
        "itemRender": [
          {
            "field": "title",
            "as": "heading",
            "label": "标题"
          },
          {
            "field": "description",
            "as": "text",
            "label": "描述"
          }
        ]
      },
      {
        "field": "additionalContent",
        "as": "section",
        "label": "建议补充内容"
      },
      {
        "field": "severity",
        "as": "tag",
        "label": "问题严重程度",
        "map": {
          "高": "high",
          "中": "mid",
          "低": "low"
        }
      }
    ]
  }
}